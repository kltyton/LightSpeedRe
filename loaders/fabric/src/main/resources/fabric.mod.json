  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["CCr4ft3r", "kltyton"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.ccr4ft3r.lightspeed.Main"],
    "client": ["com.ccr4ft3r.lightspeed.client.FabricClientInitializer"]
